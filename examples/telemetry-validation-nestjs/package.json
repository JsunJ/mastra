{
  "name": "telemetry-validation-nestjs",
  "version": "1.0.0",
  "description": "NestJS test setup to validate Mastra telemetry streaming fix with self-hosted Laminar",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "echo \"No tests specified\"",
    "test:telemetry": "node test-setup.js"
  },
  "dependencies": {
    "@mastra/core": "file:../../packages/core",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "openai": "^4.75.1",
    "@ai-sdk/openai": "^1.0.29",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.201.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.201.1",
    "@opentelemetry/otlp-exporter-base": "^0.201.1",
    "@opentelemetry/otlp-transformer": "^0.201.1",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.201.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "ai": "^4.3.16"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mastra",
    "telemetry",
    "nestjs",
    "laminar",
    "streaming",
    "self-hosted"
